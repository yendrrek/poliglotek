#!/bin/bash

# Commands this script can be executed with:
# 1. `bash podman-build -i <environment_type>`. Creates an image. Environment type must be `dev` or `prod`
# 2. `bash podman-build -c <image_id>. Creates a container
# 3. `bash podman-build -t <image_id>. Tags an image before pushing to registry
# 4. `bash podman-build -p <image_id>. Pushes image to registry

# Commands used for tagging and pushing. Just for a reference.
# podman tag poliglotek:0.48.38-792b046 europe-west2-docker.pkg.dev/translation-to-polish-437813/poliglotek/poliglotek:0.48.38-792b046
# podman push europe-west2-docker.pkg.dev/translation-to-polish-437813/poliglotek/poliglotek:0.48.38-792b046

# Exit on error, undefined variable, or pipe failure
set -euo pipefail

# Create an array with shell constants which must be set in bashrc before running the script
PREDEFINED_SHELL_CONSTANTS=(POLIGLOTEK_PROJECT_ROOT GOOGLE_CREDS_FILE_NAME ENV_VARS_FILE_PATH EXPOSED_PORT)

# Flag to track if all constants are set
all_constants_set=true

# Validate shell predefined constants. If any of them is not set do not continue.
for constant in "${PREDEFINED_SHELL_CONSTANTS[@]}"; do
    if [[ -z "${!constant}" ]]; then  # Use indirect expansion to check the value of the variable
        echo "Error: The required constant '$constant' is not set"
        all_constants_set=false
    fi
done

if [[ "$all_constants_set" = false ]]; then
    echo "Set the missing constants in your bashrc and try again."
    echo " Required constants are: ${PREDEFINED_SHELL_CONSTANTS[*]}"
    exit 1
fi

# Other constants
DOCKERFILE_PATH="$POLIGLOTEK_PROJECT_ROOT/Dockerfile"
APP_NAME="poliglotek"
VALID_ENVIRONMENT_TYPES=("dev" "prod")
G_CLOUD_REGION="europe-west2-docker.pkg.dev"
G_CLOUD_PROJECT_ID="translation-to-polish-437813"

check_dependencies() {
    for cmd in podman git; do
        command -v "$cmd" >/dev/null 2>&1 || { echo "Error: $cmd is not installed."; exit 1; }
    done
}

# Retrieves application version from build.gradle
get_app_version() {
    (cd "$POLIGLOTEK_PROJECT_ROOT" && ./gradlew -q properties | grep "^version:" | sed 's/version: *//g')
}

get_commit_id() {
    git rev-parse --short HEAD
}

get_git_branch_name() {
    git rev-parse --abbrev-ref HEAD
}

# Retrieves Podman image tag to use it later in container name for easier identification
# Image tag is retrieved using image id passed from the cli as an argument
get_image_tag() {
    local image_id="$1" # To get image id use command `podman images` before running this script
    local image_tag
    check_image_id_exists "$image_id"
    image_tag=$(podman images --filter "id=$image_id" --format "{{.Tag}}" || true)
    if [[ -z "$image_tag" ]]; then
        echo "Error: Image with ID '$image_id' not found"
        exit 1
    fi
    echo "$image_tag"
}

check_image_id_exists() {
    local image_id="$1"
    mapfile -t existing_image_ids < <(podman images --quiet)
    if [[ ! " ${existing_image_ids[*]} " =~ ${image_id} ]]; then
        echo "Error: Provided image id does not exist"
        exit 1
    fi
}

get_image_name_with_tag_excluding_repo_name() {
    local image_id="$1"
    local image_name_with_tag
    check_image_id_exists "$image_id"
    image_name_with_tag=$(podman images --filter "id=$image_id" \
        --format "{{.Repository}}:{{.Tag}}" | head -n 1 | sed 's|.*/||' || true)
    if [[ -z "$image_name_with_tag" ]]; then
        echo "Error: Image with ID '$image_id' not found"
        exit 1
    fi
    echo "$image_name_with_tag"
}

make_user_answer_case_insensitive() {
    local user_answer="$1"
    echo "$user_answer" | tr '[:upper:]' '[:lower]'
}

check_id_image_with_same_tag_exists() {
    local new_image_tag="$1"
    mapfile -t images_tags < <(podman images --format "{{.Tag}}")
    if [[ " ${images_tags[*]} " == *" $new_image_tag "* ]]; then
        echo "Image with tag '${new_image_tag}' already exists"
        continue_or_not
    fi
}

continue_or_not() {
    read -r -t 30 -p "Do you want to continue? (y/n?): " user_answer
    user_answer=${user_answer:-n} # Defaults to `n` if not answered within 30 seconds
    user_answer=$(make_user_answer_case_insensitive "$user_answer")
    if [[ "${user_answer}" == "y" ]]; then
        echo "Proceeding..."
    elif [[ "$user_answer" == "n" ]]; then
        exit 0
    else
        echo "Invalid input. Answer 'y' or 'n'"
        exit 0
    fi
}

usage() {
    echo "Usage: $0 [OPTIONS] ARGUMENTS"
    echo
    echo "Options:"
    echo "  -i, --image       Build a Podman image (requires environment: dev|prod)"
    echo "  -c, --container   Run a Podman container (requires image ID)"
    echo "  -t, --tag         Tag image before pushing to registry (requires image ID)"
    echo "  -p, --push        Push image to registry (requires image ID)"
    echo
    echo "Examples:"
    echo "  Build an image for development: $0 -i dev"
    echo "  Run a container with image ID:  $0 -c <image_id>"
    echo "  Tag an image:                   $0 -t <image_id>"
    echo "  Push an image to the registry:  $0 -p <image_id>"
    echo
    exit 1
}

# Validate input arguments
# There must be two: `-i <environment_name>` or `-c <image_id>`
if [[ "$#" -lt 2 ]]; then
    usage
fi

check_dependencies

flag="$1"
arg="$2"

case $flag in
    -i|--image)
    # Check if image is being created for the most recent build of the application
    if [[ -e "$APP_JAR_FILE_PATH" ]]; then
        last_modified=$(stat --format='%y' "$APP_JAR_FILE_PATH" | cut -c 1-16) # Drops seconds and millis
        echo "The file was last modified on $last_modified"
        echo "Make sure it's the most recent build"
        continue_or_not
    fi

    # Validate mandatory environment types for image build
    # Environment type is passed from the cli as an argument
    environment="${arg}"
    if [[ ! " ${VALID_ENVIRONMENT_TYPES[*]} " =~ ${environment} ]]; then
        echo "Error: Invalid environment. Valid options are: ${VALID_ENVIRONMENT_TYPES[*]}"
        usage
    fi

    # Generate image name
    BRANCH=$(get_git_branch_name) # Branch whose name is used must be checked out when running this script
    COMMIT_ID=$(get_commit_id)
    APP_VERSION=$(get_app_version)
    IMAGE_TAG="${environment}-${BRANCH}-${COMMIT_ID}-${APP_VERSION}"
    IMAGE_NAME_WITH_TAG="${APP_NAME}:${IMAGE_TAG}"

    check_id_image_with_same_tag_exists "$IMAGE_TAG"

    echo "Building Podman image: $IMAGE_NAME_WITH_TAG"

    podman build -t "$IMAGE_NAME_WITH_TAG" -f "$DOCKERFILE_PATH";
    ;;
    -c|--container)
    image_id="$arg"
    image_tag=$(get_image_tag "$image_id")
    container_name="${APP_NAME}-${image_tag}"

    echo "Running Podman container: $container_name"

    podman run --name "$container_name" -it --secret "$GOOGLE_CREDS_FILE_NAME",type=mount \
        --env-file "$ENV_VARS_FILE_PATH" -p "$EXPOSED_PORT" "$image_id";
    ;;
    -t|--tag)
    image_name_with_tag=$(get_image_name_with_tag_excluding_repo_name "$arg")
    # APP_NAME in the below `podman` command is the repo name in registry
    podman tag "$image_name_with_tag" \
        "$G_CLOUD_REGION"/"$G_CLOUD_PROJECT_ID"/"$APP_NAME"/"$image_name_with_tag";
    ;;
    -p|--push)
    image_name_with_tag=$(get_image_name_with_tag_excluding_repo_name "$arg")
    podman push "$G_CLOUD_REGION"/"$G_CLOUD_PROJECT_ID"/"$APP_NAME"/"$image_name_with_tag"
    ;;
*)
    echo "Unknown flag: $flag"
    usage
    ;;
esac
