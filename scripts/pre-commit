#!/bin/bash

# Get list of staged files
staged_files=$(git diff --cached --name-only)

if [ -z "$staged_files" ]; then
    echo "No files staged for commit"
    exit 0
fi

echo "Running Gradle version bump"
./gradlew versionBump

if [ -f .git/blockCommitVar ]; then
    source .git/blockCommitVar
    echo "Variable from Gradle: $BLOCK_COMMIT"
    if [ "$BLOCK_COMMIT" == true ]; then
        echo "Commit aborted"
        exit 1
    fi
else
    echo "Gradle variable not found"
fi

# Re-stage only the files that were originally staged
for file in $staged_files; do
    git add "$file"
done

# Stage build.gradle if it was modified by the version bump
if git diff --name-only | grep -q "build.gradle"; then
    git add build.gradle
fi
